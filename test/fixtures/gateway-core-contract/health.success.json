    "ok": true,
    "payload": {
      "ok": true,
      "ts": 0,
      "durationMs": 0,
      "channels": {},
      "channelOrder": [],
      "channelLabels": {},
      "heartbeatSeconds": 1800,
      "defaultAgentId": "main",
      "agents": [
        {
          "agentId": "main",
