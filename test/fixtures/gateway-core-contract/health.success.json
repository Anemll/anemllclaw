            "ackMaxChars": 300
          },
          "sessions": {
            "path": "<HOME>/.openclaw/agents/main/sessions/sessions.json",
            "count": 0,
            "recent": []
          }
        }
      ],
      "sessions": {
        "path": "<HOME>/.openclaw/agents/main/sessions/sessions.json",
        "count": 0,
        "recent": []
      }
    }
  },
  "capturedAt": "<timestamp>"
